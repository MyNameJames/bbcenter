# BBCenter V2 — Environment Variables (template)
# คัดลอกเป็น app/.env แล้วเติมค่าจริง — ห้าม commit app/.env

# --- Active Directory / LDAP ---
AD_SERVER=10.0.0.1
AD_DOMAIN=example.net
SEARCH_BASE=DC=example,DC=net

# --- Flask ---
# gen: python -c "import secrets; print(secrets.token_hex(24))"
FLASK_SECRET_KEY=
# 1 = เปิด debug (dev เท่านั้น), 0 = ปิด (production)
FLASK_DEBUG=0

# --- Dev bypass ---
# 1 = เปิด /dev/login/<username> (ห้ามใช้ production), 0/ไม่ตั้ง = ปิด
DEV_BYPASS=0

# --- Telegram Bot (แจ้งเตือนการจองรถ) ---
# ขอจาก @BotFather — ถ้ารั่วต้อง /revoke แล้วใส่ token ใหม่ที่นี่
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
